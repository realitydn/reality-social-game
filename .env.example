# Copy to .dev.vars for local development with `wrangler` / `opennextjs-cloudflare preview`,
# and copy to .env.local for `next dev`.
# Production values go in Cloudflare via `wrangler secret put <NAME>`.

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App ---
# Base URL of the deployed app (no trailing slash). Used as a fallback when
# request headers are unavailable (e.g. for QR generation in scripts).
APP_URL=http://localhost:3000

# Comma-separated list of staff emails who can access /admin routes.
# Phase 1 soft gate — replace with role-based access when staff accounts are formalized.
ADMIN_EMAILS=

# --- Resend (newsletter sync — used in Phase 0+ for opt-in storage) ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# --- Photos (R2) ---
# Public base URL of the PHOTOS bucket. Set up an R2 custom domain
# (e.g. photos.realitydn.com) and put the full URL here.
# In production set with: npx wrangler secret put PHOTOS_BASE_URL
PHOTOS_BASE_URL=
